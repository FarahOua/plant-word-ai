# Configuration du backend PlantWorld AI
# Copiez ce fichier en .env puis adaptez les valeurs : cp .env.example .env
# Toutes les variables sont obligatoires, sauf MODEL_REVISION et N8N_API_KEY.

# --- Serveur -------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8020
# Mode debug Flask (1 = activé, 0 = désactivé)
FLASK_DEBUG=1
# Taille maximale des images envoyées, en Mo
MAX_UPLOAD_MB=10

# --- Modèle de détection des maladies (Hugging Face) ----------------------
MODEL_NAME=ozair23/mobilenet_v2_1.0_224-finetuned-plantdisease
# Version figée du modèle (laisser vide pour la dernière version)
MODEL_REVISION=d892f1db24339d7b3a5871b1ceed45f52125825d
# cpu, mps (Mac Apple Silicon) ou cuda (carte NVIDIA)
MODEL_DEVICE=cpu
# 1 = charger le modèle au démarrage (première analyse plus rapide)
MODEL_PRELOAD=1
# Confiance minimale (0 à 1) pour considérer la plante comme reconnue
CONFIDENCE_THRESHOLD=0.7
# Nombre de prédictions calculées
TOP_K=3

# --- Chatbot : workflow n8n ----------------------------------------------
# URL de production du webhook (le workflow doit être actif dans n8n)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/plantworld-chat
# Valeur de l'en-tête X-API-Key attendue par le nœud Webhook (Header Auth)
N8N_API_KEY=
# Délai maximal d'attente de la réponse de n8n, en secondes
N8N_TIMEOUT=60
